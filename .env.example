# App-to-gateway settings. Set LLM_API_KEY to match LITELLM_MASTER_KEY in gateway.env.
LLM_PROVIDER=litellm-gateway
LLM_MODEL=receptionist-openai
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=sk-local-dev-change-me
BUSINESS_PROFILE=./business-profile.json
RECEPTIONIST_DB=./data/receptionist.sqlite3

# Optional live Pipecat voice channel
# Local offline speech defaults. First start downloads the selected models.
VOICE_STT_PROVIDER=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_HI_VOICE=hi_IN-priyamvada-medium
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.8
VOICE_TTS_PROVIDER=auto
KOKORO_VOICE=af_heart
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
