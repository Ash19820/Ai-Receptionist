# Copy to .env only when you are ready to test Gemini Live.
# The key stays on this computer and is never sent to the browser.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional LiveKit Agents path. Needed only for the new LiveKit runtime.
# Create a LiveKit Cloud project and copy its WebSocket URL and API credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_GEMINI_VOICE=Puck
# Optional override only when serving the browser UI from a different trusted origin.
# RECEPTIONIST_ALLOWED_ORIGINS=https://assistant.example.com
# Comma-separated languages the receptionist may speak. Default: English.
ASSISTANT_ALLOWED_LANGUAGES=English
# Optional path to the operator-verified business facts JSON file.
BUSINESS_PROFILE_PATH=business_profile.json
# Confirmed callback messages stay on this computer and expire after 7 days.
CALLBACK_MESSAGE_DB_PATH=data/callback_messages.sqlite3
CALLBACK_MESSAGE_RETENTION_DAYS=7
