LITELLM_MASTER_KEY=sk-local-dev-change-me

# Fill in only the provider you selected in .env's LLM_MODEL.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
